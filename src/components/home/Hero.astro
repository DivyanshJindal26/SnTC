---
/**
 * Photo-led hero.
 *
 * The council's own work is the strongest thing it has — a Mars rover, a
 * Formula car, a CANSAT. So the page opens on one of those photographs at
 * full bleed, with the headline over it, rather than on a graphic device.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../../data/site';

interface Props {
  image: ImageMetadata;
  /** what the photo actually shows, for the caption */
  credit: string;
  stats: { value: string | number; label: string }[];
}

const { image, credit, stats } = Astro.props;
---

<section class="hero">
  <Image
    class="hero__img"
    src={image}
    alt=""
    widths={[900, 1400, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero__scrim"></div>

  <div class="hero__content page">
    <p class="hero__eyebrow">{site.institute}</p>
    <h1 class="hero__title">Science and Technology Council</h1>
    <p class="hero__lede">
      Eight clubs and four cells building rovers, satellites, race cars and
      rockets. Open to every student, at any point in the year.
    </p>

    <div class="hero__actions">
      <a class="btn btn--onphoto" href="/clubs/">Explore the clubs</a>
      <a class="btn btn--ghost-onphoto" href="/projects/">See our projects</a>
    </div>
  </div>

  <p class="hero__credit">{credit}</p>
</section>

<div class="statbar">
  <div class="page statbar__inner">
    {
      stats.map((s) => (
        <div class="statbar__item">
          <span class="statbar__value">{s.value}</span>
          <span class="statbar__label">{s.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(38rem, 74vh);
    isolation: isolate;
    background: var(--navy-deep);
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Navy-tinted scrim: ties the photo to the palette and guarantees the
     headline has contrast whatever photograph is swapped in. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgba(9, 22, 51, 0.94) 0%,
        rgba(9, 22, 51, 0.72) 42%,
        rgba(9, 22, 51, 0.36) 75%,
        rgba(9, 22, 51, 0.28) 100%
      );
  }

  .hero__content {
    width: 100%;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    color: #fff;
  }

  .hero__eyebrow {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 0.85rem;
  }

  .hero__title {
    font-size: var(--t-hero);
    color: #fff;
    max-width: 19ch;
    margin: 0 0 0.9rem;
    letter-spacing: -0.022em;
    line-height: 1.08;
  }

  .hero__lede {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    margin: 0 0 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .hero__credit {
    position: absolute;
    right: var(--gutter);
    bottom: 0.75rem;
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: right;
    max-width: 40%;
  }

  @media (max-width: 700px) {
    .hero__credit {
      display: none;
    }
  }

  /* --- stat bar -------------------------------------------------------- */
  .statbar {
    background: var(--navy);
    color: #fff;
  }

  .statbar__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  }

  .statbar__item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 1.1rem 0.5rem 1.1rem 0;
  }

  .statbar__item + .statbar__item {
    padding-left: 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }

  .statbar__value {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .statbar__label {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
</style>
