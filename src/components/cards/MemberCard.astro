---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { initials } from '../../lib/members';

interface Props {
  member: CollectionEntry<'members'>;
}

const { member } = Astro.props;
const { name, role, photo, linkedin, instagram, github, email, isLead } = member.data;

const socials = [
  linkedin && { href: linkedin, label: `${name} on LinkedIn`, key: 'in' },
  github && { href: github, label: `${name} on GitHub`, key: 'gh' },
  instagram && { href: instagram, label: `${name} on Instagram`, key: 'ig' },
  email && { href: `mailto:${email}`, label: `Email ${name}`, key: 'em' },
].filter(Boolean) as { href: string; label: string; key: string }[];
---

<article class:list={['mcard', isLead && 'mcard--lead']}>
  <div class="mcard__photo">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Portrait of ${name}`}
          width={360}
          height={360}
          densities={[1, 2]}
          loading="lazy"
        />
      ) : (
        <span class="mcard__initials" aria-hidden="true">{initials(name)}</span>
      )
    }
  </div>

  <h3 class="mcard__name">{name}</h3>
  <p class="mcard__role">{role}</p>

  {
    socials.length > 0 && (
      <ul class="mcard__social">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              <span class="visually-hidden">{s.label}</span>
              <span aria-hidden="true">{s.key}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .mcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    height: 100%;
    transition:
      border-color var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }

  .mcard:hover {
    border-color: color-mix(in oklab, var(--navy) 30%, var(--line));
    box-shadow: var(--shadow-sm);
  }

  .mcard--lead {
    border-color: color-mix(in oklab, var(--navy) 40%, var(--line));
    background: var(--navy-tint);
  }

  .mcard__photo {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper-3);
    display: grid;
    place-items: center;
    margin-bottom: 0.9rem;
  }

  .mcard__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mcard__initials {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--navy);
  }

  .mcard__name {
    font-size: 1.02rem;
    margin: 0 0 0.15rem;
  }

  .mcard__role {
    font-size: 0.85rem;
    color: var(--ink-2);
    margin: 0;
  }

  .mcard__social {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .mcard__social a {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    background: var(--paper);
    transition:
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .mcard__social a:hover {
    color: var(--navy);
    border-color: var(--navy);
  }
</style>
