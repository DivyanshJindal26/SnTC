---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FIREBASE_CONFIG, GOOGLE_CLIENT_ID, ALLOWED_DOMAINS, API_BASE } from '../../lib/auth-config';
---

<BaseLayout
  title="Register"
  description="Register for upcoming SnTC sessions. Priority entry for first 300 registered students."
  bare
>
  <!-- Hero header -->
  <header class="reg-hero">
    <div class="reg-hero__bg"></div>
    <div class="page reg-hero__content">
      <p class="label label--light">Registration</p>
      <h1>Upcoming sessions</h1>
      <p class="reg-hero__lede">
        Register for sessions and get priority entry 15 minutes before doors open. First 300 confirmed registrations only.
      </p>

      <!-- Auth -->
      <div id="auth-area" class="auth-area">
        <div id="signed-out" class="auth-glass">
          <div class="auth-glass__inner">
            <div class="auth-glass__icon">
              <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </div>
            <div>
              <p class="auth-glass__text">Sign in with your IIT Mandi Google account</p>
            </div>
            <button id="sign-in-btn" class="btn-google">
              <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
              Sign in with Google
            </button>
          </div>
        </div>

        <div id="signed-in" class="auth-glass auth-glass--user" hidden>
          <div class="auth-glass__inner user-row">
            <img id="user-photo" class="user-avatar" src="" alt="" width="40" height="40" />
            <div class="user-details">
              <strong id="user-name"></strong>
              <span id="user-email" class="user-email"></span>
            </div>
            <button id="sign-out-btn" class="btn-sign-out">Sign out</button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Sessions -->
  <section class="section">
    <div class="page">
      <div id="sessions-loading" class="state-msg">
        <div class="spinner"></div>
        <p>Loading sessions&hellip;</p>
      </div>
      <div id="sessions-empty" class="state-msg" hidden>
        <svg class="state-icon" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <p>No upcoming sessions right now.</p>
        <p class="state-sub">Check back later — new sessions are posted regularly.</p>
      </div>
      <div id="sessions-list" class="sgrid"></div>
    </div>
  </section>

  <!-- QR Modal -->
  <div id="qr-modal" class="modal" hidden>
    <div class="modal__backdrop"></div>
    <div class="modal__box">
      <div class="modal__header">
        <h3>Your check-in QR</h3>
        <button class="modal__close" id="qr-close">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="qr-body">
        <div class="qr-frame">
          <img id="qr-img" src="" alt="Check-in QR code" width="220" height="220" />
        </div>
        <p id="qr-session-name" class="qr-label"></p>
        <p class="qr-hint">Show this at the venue for priority check-in.</p>
        <p class="qr-hint">A copy has also been sent to your email.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Firebase Auth SDK -->
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<script is:inline define:vars={{ FIREBASE_CONFIG, GOOGLE_CLIENT_ID, ALLOWED_DOMAINS, API: API_BASE }}>

  firebase.initializeApp(FIREBASE_CONFIG);
  const auth = firebase.auth();

  let currentUser = null;
  let idToken = null;

  const $out = document.getElementById('signed-out');
  const $in = document.getElementById('signed-in');
  const $loading = document.getElementById('sessions-loading');
  const $empty = document.getElementById('sessions-empty');
  const $list = document.getElementById('sessions-list');
  const $qrModal = document.getElementById('qr-modal');
  const $qrImg = document.getElementById('qr-img');
  const $qrName = document.getElementById('qr-session-name');

  const tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: GOOGLE_CLIENT_ID,
    scope: 'openid email profile',
    callback: async (tokenResponse) => {
      if (tokenResponse.error) {
        console.error('Google sign-in error:', tokenResponse);
        return;
      }
      try {
        const credential = firebase.auth.GoogleAuthProvider.credential(null, tokenResponse.access_token);
        const result = await auth.signInWithCredential(credential);
        const domain = result.user.email.split('@')[1];
        if (!ALLOWED_DOMAINS.includes(domain)) {
          await auth.signOut();
          alert('Only IIT Mandi accounts (@iitmandi.ac.in / @students.iitmandi.ac.in) are allowed.');
        }
      } catch (err) {
        console.error('Firebase sign-in error:', err);
        alert('Sign-in failed. Please try again.');
      }
    },
  });

  document.getElementById('sign-in-btn').addEventListener('click', () => {
    tokenClient.requestAccessToken();
  });

  document.getElementById('sign-out-btn').addEventListener('click', () => auth.signOut());

  auth.onAuthStateChanged(async (user) => {
    if (user) {
      const domain = user.email.split('@')[1];
      if (!ALLOWED_DOMAINS.includes(domain)) {
        await auth.signOut();
        alert('Only IIT Mandi accounts are allowed.');
        return;
      }
    }
    currentUser = user;
    if (user) {
      idToken = await user.getIdToken();
      $out.hidden = true;
      $in.hidden = false;
      document.getElementById('user-photo').src = user.photoURL || '';
      document.getElementById('user-photo').hidden = !user.photoURL;
      document.getElementById('user-name').textContent = user.displayName || user.email;
      document.getElementById('user-email').textContent = user.email;
    } else {
      idToken = null;
      $out.hidden = false;
      $in.hidden = true;
    }
    loadSessions();
  });

  document.getElementById('qr-close').addEventListener('click', () => $qrModal.hidden = true);
  document.querySelector('.modal__backdrop').addEventListener('click', () => $qrModal.hidden = true);

  function showQR(qrDataUrl, sessionTitle) {
    $qrImg.src = qrDataUrl;
    $qrName.textContent = sessionTitle;
    $qrModal.hidden = false;
  }

  async function loadSessions() {
    $loading.hidden = false;
    $empty.hidden = true;
    $list.innerHTML = '';

    try {
      const res = await fetch(API + '/sessions');
      const sessions = await res.json();
      $loading.hidden = true;

      const now = new Date();
      const upcoming = sessions.filter(s => new Date(s.starts_at) > now);

      if (upcoming.length === 0) { $empty.hidden = false; return; }

      for (const s of upcoming) {
        let myReg = null, qr = null;
        if (idToken) {
          try {
            const r = await fetch(`${API}/sessions/${s.id}/my-registration`, {
              headers: { Authorization: 'Bearer ' + idToken },
            });
            const d = await r.json();
            myReg = d.registration;
            qr = d.qr;
          } catch {}
        }
        $list.appendChild(renderSession(s, myReg, qr));
      }
    } catch {
      $loading.hidden = true;
      $empty.querySelector('p').textContent = 'Failed to load sessions.';
      $empty.hidden = false;
    }
  }

  function renderSession(session, myReg, qr) {
    const card = document.createElement('div');
    card.className = 'scard';

    const spots = session.capacity - session.registration_count;
    const full = spots <= 0;
    const d = new Date(session.starts_at);

    const day = d.getDate();
    const month = d.toLocaleDateString('en-IN', { month: 'short' }).toUpperCase();
    const weekday = d.toLocaleDateString('en-IN', { weekday: 'long' });
    const time = d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });

    let pct = Math.min(100, (session.registration_count / session.capacity) * 100);
    let barCls = pct > 90 ? 'bar--danger' : pct > 70 ? 'bar--warn' : '';

    const registered = !!myReg;

    card.innerHTML = `
      <div class="scard__top">
        <div class="scard__date-badge">
          <span class="scard__day">${day}</span>
          <span class="scard__month">${month}</span>
        </div>
        <div class="scard__info">
          <h3 class="scard__title">${esc(session.title)}</h3>
          <div class="scard__meta">
            <span class="scard__meta-item">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              ${weekday}, ${time}
            </span>
            <span class="scard__meta-item">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
              ${esc(session.venue)}
            </span>
          </div>
        </div>
        ${registered ? '<span class="scard__check">&#10003;</span>' : ''}
      </div>
      ${session.description ? '<p class="scard__desc">' + esc(session.description) + '</p>' : ''}
      <div class="scard__capacity">
        <div class="scard__bar"><div class="scard__fill ${barCls}" style="width:${pct}%"></div></div>
        <div class="scard__spots">
          <span>${session.registration_count} / ${session.capacity} registered</span>
          ${full
            ? '<span class="spots--full">Full</span>'
            : '<span class="spots--open">' + spots + ' spots left</span>'
          }
        </div>
      </div>
      <div class="scard__actions" data-sid="${session.id}"></div>
    `;

    const actions = card.querySelector('.scard__actions');

    if (!currentUser) {
      actions.innerHTML = '<p class="scard__signin-hint">Sign in above to register</p>';
    } else if (myReg) {
      const badge = document.createElement('span');
      badge.className = 'reg-badge';
      badge.innerHTML = '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg> Registered';
      actions.appendChild(badge);

      const qrBtn = document.createElement('button');
      qrBtn.className = 'btn-action btn-action--qr';
      qrBtn.innerHTML = '<svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75H16.5v-.75Z" /></svg> Show QR';
      qrBtn.addEventListener('click', () => showQR(qr, session.title));
      actions.appendChild(qrBtn);

      const cancelBtn = document.createElement('button');
      cancelBtn.className = 'btn-action btn-action--cancel';
      cancelBtn.textContent = 'Cancel';
      cancelBtn.addEventListener('click', () => cancelReg(session.id));
      actions.appendChild(cancelBtn);
    } else if (!session.registration_open) {
      actions.innerHTML = '<p class="scard__signin-hint">Registration closed</p>';
    } else if (full) {
      actions.innerHTML = '<p class="scard__signin-hint spots--full">Registration full</p>';
    } else {
      const btn = document.createElement('button');
      btn.className = 'btn-register';
      btn.textContent = 'Register now';
      btn.addEventListener('click', () => doRegister(session, btn));
      actions.appendChild(btn);
    }

    return card;
  }

  async function doRegister(session, btn) {
    btn.disabled = true;
    btn.textContent = 'Registering…';

    try {
      idToken = await currentUser.getIdToken(true);
      const res = await fetch(`${API}/sessions/${session.id}/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + idToken },
        body: '{}',
      });

      if (!res.ok) {
        const e = await res.json();
        alert(e.error || 'Registration failed');
        btn.disabled = false; btn.textContent = 'Register now';
        return;
      }

      const data = await res.json();
      showQR(data.qr, session.title);
      loadSessions();
    } catch {
      alert('Network error. Try again.');
      btn.disabled = false; btn.textContent = 'Register now';
    }
  }

  async function cancelReg(sessionId) {
    if (!confirm('Cancel your registration?')) return;
    try {
      idToken = await currentUser.getIdToken(true);
      await fetch(`${API}/sessions/${sessionId}/register`, {
        method: 'DELETE', headers: { Authorization: 'Bearer ' + idToken },
      });
      loadSessions();
    } catch { alert('Failed to cancel.'); }
  }

  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
</script>

<!-- Global (not Astro-scoped): session cards and their controls are injected
     with JS, so scoped styles would never reach them. -->
<style is:global>
  /* ============================== HERO ============================== */
  .reg-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem) clamp(3.5rem, 2.5rem + 5vw, 6rem);
  }

  .reg-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 100%, rgba(193,67,40,.25), transparent),
      radial-gradient(ellipse 70% 50% at 80% 0%, rgba(22,58,125,.6), transparent);
    pointer-events: none;
  }

  .reg-hero__content {
    position: relative;
    z-index: 1;
  }

  .reg-hero h1 {
    color: #fff;
    font-size: var(--t-h1);
    margin: 0.3rem 0 0.8rem;
  }

  .reg-hero__lede {
    color: rgba(255,255,255,.8);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    max-width: 52ch;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .label--light {
    color: #ffb9a4;
  }

  /* ============================== AUTH GLASS ============================== */
  .auth-glass {
    max-width: 520px;
  }

  .auth-glass__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255,255,255,.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 12px;
  }

  .auth-glass__icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.12);
    border-radius: 10px;
    color: #fff;
  }

  .auth-glass__text {
    margin: 0;
    font-size: var(--t-small);
    color: rgba(255,255,255,.85);
    line-height: 1.4;
  }

  .btn-google {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: #fff;
    color: #3c4043;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: box-shadow var(--fast) var(--ease), transform var(--fast) var(--ease);
    white-space: nowrap;
  }

  .btn-google:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,.25);
    transform: translateY(-1px);
  }

  /* Signed-in row */
  .user-row {
    gap: 0.75rem;
  }

  .user-avatar {
    border-radius: 50%;
    width: 40px;
    height: 40px;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,.3);
  }

  .user-details {
    flex: 1;
    min-width: 0;
  }

  .user-details strong {
    display: block;
    color: #fff;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-email {
    display: block;
    font-size: 0.8rem;
    color: rgba(255,255,255,.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-sign-out {
    flex-shrink: 0;
    padding: 0.4rem 0.9rem;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 6px;
    color: rgba(255,255,255,.85);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--fast) var(--ease);
  }

  .btn-sign-out:hover {
    background: rgba(255,255,255,.2);
  }

  /* ============================== STATES ============================== */
  .state-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4rem 1rem;
    text-align: center;
    color: var(--ink-2);
  }

  .state-msg p { margin: 0; }

  /* display:flex above would override the hidden attribute without this */
  .state-msg[hidden] { display: none; }

  .state-icon {
    color: var(--ink-3);
    opacity: .5;
  }

  .state-sub {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--line);
    border-top-color: var(--navy);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ============================== SESSION GRID ============================== */
  .sgrid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .scard {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition:
      border-color var(--mid) var(--ease),
      box-shadow var(--mid) var(--ease),
      transform var(--mid) var(--ease);
  }

  .scard:hover {
    border-color: color-mix(in oklab, var(--navy) 40%, var(--line));
    box-shadow: 0 8px 30px -10px rgba(18,24,33,.15);
    transform: translateY(-2px);
  }

  /* Top row: date badge + info */
  .scard__top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .scard__date-badge {
    flex-shrink: 0;
    width: 54px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--navy);
    color: #fff;
    border-radius: 10px;
    padding: 0.5rem 0.4rem;
    line-height: 1;
  }

  .scard__day {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .scard__month {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-top: 0.15rem;
    opacity: .8;
  }

  .scard__info {
    flex: 1;
    min-width: 0;
  }

  .scard__title {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    color: var(--navy);
    line-height: 1.25;
  }

  .scard__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .scard__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .scard__meta-item svg {
    flex-shrink: 0;
    color: var(--ink-3);
    opacity: .7;
  }

  .scard__check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    background: #e6f4ea;
