# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Firebase ────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# ── Access control ──────────────────────────────────────
# Comma-separated admin emails (can create/manage sessions)
ADMIN_EMAILS=saic@students.iitmandi.ac.in,technical_secretary@students.iitmandi.ac.in,sntc@iitmandi.ac.in

# Allowed email domains for student registration
ALLOWED_DOMAINS=iitmandi.ac.in,students.iitmandi.ac.in

# ── Email (SMTP) ───────────────────────────────────────
# Any SMTP provider works: Gmail App Password, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=SNTC IIT Mandi <noreply@example.com>
# ── Reverse proxy ───────────────────────────────────────
# Set to 1 when running behind nginx/caddy (number of proxy hops)
TRUST_PROXY=1

# ── Paths ───────────────────────────────────────────────
DIST_PATH=../dist

# ── Site URL (for email links) ──────────────────────────
SITE_URL=https://sntc.iitmandi.co.in

# ── CORS (comma-separated origins, or * for dev) ───────
CORS_ORIGINS=https://sntc.iitmandi.co.in,http://localhost:4321

# ── Rate limiting ───────────────────────────────────────
# Max registration attempts per IP per 15-minute window
RATE_LIMIT_REGISTER=10
RATE_LIMIT_GENERAL=100
