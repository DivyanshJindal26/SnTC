# Copy to .env and fill in. All values here are public browser-side identifiers
# (Firebase web config + OAuth client ID), not secrets. Server secrets live in
# server/.env (see server/.env.example).

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services → Credentials).
# The deployed site origin MUST be listed under "Authorized JavaScript origins".
PUBLIC_GOOGLE_CLIENT_ID=

# Comma-separated email domains allowed to sign in.
PUBLIC_ALLOWED_DOMAINS=iitmandi.ac.in,students.iitmandi.ac.in

# Host port for docker compose. Local dev: 3000. Production: omit (defaults to 8324).
# HOST_PORT=3000
